{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randumbloke/cdmc-governance/schemas/infotype_rules.schema.json",
  "title": "classification/infotype_rules.yaml (design §5.3.3)",
  "type": "object",
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "info_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "level": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
          "rationale": {"type": "string", "minLength": 1}
        },
        "required": ["info_type", "level", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "rules"],
  "additionalProperties": false
}
